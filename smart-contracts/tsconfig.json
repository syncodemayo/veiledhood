{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "hardhat.config.ts",
    "deploy",
    "test",
    "scripts",
    "typechain-types"
  ]
}
