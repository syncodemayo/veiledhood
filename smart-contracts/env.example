# Veiledhood smart-contracts (see README in this folder)
# Deployment Configuration (Hardhat)
PRIVATE_KEY=

# Network RPC URLs (Robinhood Chain Testnet, chainId 46630)
RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# API Keys
VERIFICATION_API_KEY=

# MockUSDC only (01_deploy_mock_usdc.ts)
# MOCK_USDC_INITIAL_SUPPLY=1000000000000

# Veiledhood deploy (02_deploy_veiledhood.ts) — optional (defaults to deployer)
# VEILEDHOOD_ADMIN=0x...
# VEILEDHOOD_WITHDRAW_SIGNER=0x...

# Veiledhood on Ethereum deploy (03_deploy_veiledhood_eth_vault.ts) — deploys the same Veiledhood.sol
# VEILEDHOOD_ETH_WITHDRAW_SIGNER=0x...  # optional, defaults to deployer
