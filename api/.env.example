# Ledger `currency`: ERC-20 = lowercase `0x` token address; native ETH = `native`
MONGODB_URI=mongodb://127.0.0.1:27017/veiledhood
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000

# JSON-RPC for Veiledhood + indexer (required for on-chain payout / Merkle commits).
# Robinhood Chain Testnet.
#RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Optional static chain id (recommended in production).
#CHAIN_ID=46630

# Admin: `updateMerkleRoot` + `adminWithdraw`. Falls back to DEPLOYER_PRIVATE_KEY if unset.
ADMIN_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
# EIP-712 `WithdrawAuth` signer (must match Veiledhood `_withdrawSigner`).
SIGNER_PRIVATE_KEY=

# Single Veiledhood vault (ERC-20 + native ETH via `deposit` with token `address(0)`).
VAULT_ADDRESS=

# Second-chain support (ETH_RPC_URL / ETH_VAULT_ADDRESS / ETH_CHAIN_ID) is unused in this
# single-chain (Robinhood Chain Testnet only) deployment — leave unset.

# Deposit indexer (startup catch-up + live `Deposited` listener):
# first block when no cursor exists (inclusive floor).
MERKLE_INDEXER_FROM_BLOCK=0
# Free-tier RPCs often cap `eth_getLogs` ranges (e.g. 10 blocks).
INDEXER_LOG_CHUNK_BLOCKS=10

# Per-token transfer fees: JSON map of `native` or lowercase `0x…` → `{ "fixed": "1000", "bps": 10 }`.
# `fixed` = raw token units per transfer (string digits). `bps` = 0–10000.
# TRANSFER_FEE_CONFIG_JSON={"native":{"fixed":"0","bps":0},"0x833589fcd6edb6e08f4c7c32d4f71b54bda02913":{"fixed":"100","bps":50},"0xd13ba0d625c04b8364de5e15e58bf2ebdda8dba3":{"fixed":"0","bps":0}}
TRANSFER_FEE_LEDGER_ADDRESS=

WITHDRAW_DEADLINE_MAX_SEC=900

# === Private AI (Phase 1) ===
# SolRouter API key (sk_solrouter_...). Funds inference; pooled across all users.
SOLROUTER_API_KEY=
# Override only if SolRouter publishes a new endpoint. Defaults to the SDK built-in.
# SOLROUTER_BASE_URL=https://solrouter-obb4.onrender.com

# Comma-separated allowlist exposed to the chat UI. Cheap models only.
AI_MODEL_WHITELIST=gpt-oss-20b,gpt-4o-mini

# Tor SOCKS5 client (systemd-managed in prod). Required when TOR_ENABLED=true.
TOR_ENABLED=true
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# Per-user quotas.
AI_RATE_LIMIT_PER_USER_PER_DAY=50
AI_RATE_LIMIT_PER_USER_PER_MIN=5
AI_RATE_LIMIT_DISABLED=false

# Redis for rate-limit counters. In prod use a managed instance or sidecar.
REDIS_URL=redis://127.0.0.1:6379

# --- Private bridging (Base <-> Eth) ---
BRIDGE_ENABLED=false
# BIP-39 mnemonic for escrow wallets — SECRET, set only in the prod secret store
BRIDGE_ESCROW_SEED=
DEBRIDGE_API_URL=https://dln.debridge.finance/v1.0
DEBRIDGE_REFERRAL_CODE=
BRIDGE_FEE_BPS=0
BRIDGE_USER_DAILY_QUOTA=10
DEBRIDGE_STATS_API_URL=https://dln-api.debridge.finance/api
